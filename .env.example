# Azure Postgres Database
# Use PgBouncer port 6432 (already active on the Flexible Server)
# sslmode=verify-full is required — SSL config is driven by the URL, not code
# Format: postgresql://<user>:<pass>@<host>:6432/<db>?sslmode=verify-full
DATABASE_URL=

# Direct (non-PgBouncer) connection for the data-processing pipeline's database
# writers (report_mandate_links). Port 5432, deliberately not the 6432 above:
# a batch writer wants a direct connection, PgBouncer has shown startup-packet
# incompatibilities with some clients, and the measurements behind the
# extractor's selection were all taken on 5432. sslmode must be stated
# explicitly in the URL — the entry point refuses a URL without one rather
# than fall back to libpq's weaker default.
# Both the website and pipeline reject weaker SSL modes. Python uses the system
# CA bundle unless sslrootcert is explicitly supplied in the URL.
# Format: postgresql://<user>:<pass>@<host>:5432/<db>?sslmode=verify-full
PIPELINE_DATABASE_URL=
ODS_TOKEN=
AZURE_OPENAI_ENDPOINT=https://{resource}.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_API_KEY=

# Sentry user-feedback widget (the "Give Feedback" button). DSN is public and
# safe to expose client-side. Leave unset locally — with no DSN the widget
# simply doesn't mount. Set this in the Azure app env to enable feedback in
# production. NEXT_PUBLIC_ vars are baked in at build time, so it must be
# present when `pnpm build` runs.
NEXT_PUBLIC_SENTRY_DSN=
